APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://tarot:change_me@db:5432/ai_tarot
AUTH_SECRET=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_MODE=cookie
LLM_PROVIDER=openai_compatible
# Phase 0 reserves configuration only; no model is installed or called.
# For a future local Qwen3-0.6B service, use its actual base URL and model ID.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=3000
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
RAG_ENABLED=false
RAG_TOP_K=5
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
