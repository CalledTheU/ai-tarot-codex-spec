APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://tarot:change_me@db:5432/ai_tarot
# Opaque Bearer sessions are stored as SHA-256 digests; no JWT signing secret is used.
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_MODE=bearer
AUTH_REQUESTS_PER_MINUTE=20
READINGS_PER_MINUTE=10
MODEL_REQUESTS_PER_MINUTE=5
MODEL_MAX_CONCURRENCY=2
# Vite development proxy (set in its shell; change if Windows reserves port 8000).
API_PROXY_TARGET=http://127.0.0.1:8000
LLM_PROVIDER=openai_compatible
# Optional. No model is installed/downloaded automatically.
# Base URL must include /v1 if required by your OpenAI-compatible service.
# Blank endpoint/model returns 503 only for interpretation; drawing still works.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=3000
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
RAG_ENABLED=false
RAG_TOP_K=5
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
